# Database (self-hosted PostgreSQL)
DATABASE_URL="postgresql://lawkita:change-me@localhost:5432/lawkita"

# Better Auth
# Generate secret: bunx @better-auth/cli secret
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (Email)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="noreply@lawkita.my"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_xxx"
STRIPE_PREMIUM_ANNUAL_PRICE_ID="price_xxx"
STRIPE_FEATURED_MONTHLY_PRICE_ID="price_xxx"
STRIPE_FEATURED_ANNUAL_PRICE_ID="price_xxx"

# OpenAI (Document Verification & Moderation)
OPENAI_API_KEY="sk-your-openai-api-key"

# WhatsApp Business API (Claim Verification)
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"

# Admin Notifications
ADMIN_EMAIL="admin@lawkita.my"

# Firecrawl (News Crawling)
FIRECRAWL_API_KEY="fc-your-firecrawl-api-key"

# Cron Job Security
CRON_SECRET="your-cron-secret-key"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-master-key"

# Object Storage (Garage, S3-compatible)
# Use "garage" for the new backend. Set "legacy" temporarily during cutover.
STORAGE_BACKEND="garage"
GARAGE_ENDPOINT="http://localhost:3900"
GARAGE_REGION="garage"
GARAGE_ACCESS_KEY_ID="your-garage-access-key"
GARAGE_SECRET_ACCESS_KEY="your-garage-secret-key"
GARAGE_PUBLIC_BASE_URL="https://storage.lawkita.com"
GARAGE_FORCE_PATH_STYLE="true"
GARAGE_BUCKET_IMAGES="images"
GARAGE_BUCKET_DOCUMENTS="documents"

# Temporary legacy storage compatibility (server-only; omit after cutover)
# STORAGE_BACKEND="legacy"
# LEGACY_STORAGE_URL="https://legacy-storage.example.com"
# LEGACY_STORAGE_TOKEN="your-legacy-storage-token"

# Temporary legacy cases-query compatibility. When both are set, public cases
# continue through the historical PostgREST path; omit them on self-hosted-only deployments.
# LEGACY_CASES_URL="https://your-project.supabase.co"
# LEGACY_CASES_ANON_KEY="your-anon-key"
# Self-hosted deployments must explicitly opt in while the historical cases failure remains open.
CASES_QUERY_BACKEND="postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Analytics (optional — GTM handles GA4 internally; leave unset to disable)
# When NEXT_PUBLIC_GTM_ID is empty, no analytics scripts are injected at all.
NEXT_PUBLIC_GTM_ID=""            # GTM-XXXXXXX — the only value needed for client-side tracking
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=""  # G-XXXXXXXXXX — only if you also fire GA4 directly (not needed with GTM)
# GOOGLE_SITE_VERIFICATION=""        # only if switching GSC from DNS to HTML-tag verification
