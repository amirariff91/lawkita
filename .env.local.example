# Local self-hosted development configuration
# Copy to .env.local and adjust credentials for the local services.

# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lawkita"

# Local Garage (S3-compatible object storage)
# STORAGE_BACKEND can be set to "legacy" temporarily during a storage cutover.
STORAGE_BACKEND="garage"
GARAGE_ENDPOINT="http://localhost:3900"
GARAGE_REGION="garage"
GARAGE_ACCESS_KEY_ID="local-garage-access-key"
GARAGE_SECRET_ACCESS_KEY="local-garage-secret-key"
GARAGE_PUBLIC_BASE_URL="http://localhost:3900"
GARAGE_FORCE_PATH_STYLE="true"
GARAGE_BUCKET_IMAGES="images"
GARAGE_BUCKET_DOCUMENTS="documents"
